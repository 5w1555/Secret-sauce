---
import SEO from '../components/SEO.astro';
import { siteConfig } from '../config/site.config.js';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={title} description={description} path={path} />
  </head>
  <body class="min-h-screen flex flex-col text-gray-900">
    <header class="border-b">
      <nav class="max-w-3xl mx-auto flex items-center justify-between p-4">
        <a href="/" class="font-bold text-lg">{siteConfig.name}</a>
        <ul class="flex gap-4 text-sm">
          {siteConfig.nav.map((item) => (
            <li><a href={item.href} class="hover:underline">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto w-full p-4 flex-1">
      <slot />
    </main>

    <footer class="border-t text-sm text-gray-500 p-4 text-center">
      &copy; {new Date().getFullYear()} {siteConfig.name}
    </footer>
  </body>
</html>
